PORT=5000
MONGO_URI=mongodb://localhost:27017/smartcrate
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=10000
NODE_ENV=development

# Hardware devices use X-Device-Api-Key. Store only its hash in Device.apiKeyHash.
# The local React simulator uses the authenticated farmer JWT and source=simulator.

# OTP config
# In development, DEMO_OTP is used. In production, connect a real SMS provider.
DEMO_OTP=1234
OTP_EXPIRES_MINUTES=10

# SMS provider (future)
# SMS_API_KEY=
# SMS_SENDER_ID=
